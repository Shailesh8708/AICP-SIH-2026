{
  "name": "aicp-server",
  "version": "1.0.0",
  "description": "AICP - Backend Express.js Server",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "clean-port": "powershell -Command \"Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force; Write-Host 'Port 5000 cleared' }\"",
    "test": "vitest",
    "seed": "node ../scripts/seedData.js",
    "lint": "eslint src --ext .js",
    "format": "prettier --write src"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "mammoth": "^1.8.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.0",
    "nodemailer": "^6.9.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.1.0",
    "vitest": "^1.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.21.5": true
  }
}
